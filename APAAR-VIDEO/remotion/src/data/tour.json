{
 "fps": 30,
 "total": 219.882,
 "segments": [
  {
   "id": "k00_meet",
   "section": "The problem",
   "title": "One student among lakhs",
   "points": [],
   "role": "",
   "start": 0.0,
   "dur": 9.877,
   "voice": null,
   "voiceStart": 0.4,
   "text": "Meet Ananya. This year she joined an engineering college, one of lakhs of students admitted to AICTE-approved institutions. But today, oversight sees only totals.",
   "sentences": []
  },
  {
   "id": "k01_problem",
   "section": "The problem",
   "title": "Totals hide students",
   "points": [],
   "role": "",
   "start": 9.877,
   "dur": 17.514,
   "voice": null,
   "voiceStart": 10.277,
   "text": "A college reports how many it admitted, not who. Excess admissions hide inside those numbers. The same student can be enrolled at two colleges at once. And when an employer asks if Ananya's degree is real, the answer is a letter and a long wait.",
   "sentences": []
  },
  {
   "id": "k02_idea",
   "section": "The idea",
   "title": "One register of students",
   "points": [],
   "role": "",
   "start": 27.391,
   "dur": 10.605,
   "voice": null,
   "voiceStart": 27.791,
   "text": "The APAAR Student Register changes that. Every enrolment is an individual record, keyed to the student's APAAR ID, and every number is counted from those records.",
   "sentences": []
  },
  {
   "id": "k03_upload",
   "section": "Chapter 1 \u00b7 The college",
   "title": "Upload, checked row by row",
   "points": [
    "Excel or CSV template",
    "26 validation rules on every row",
    "Nothing saved until checked"
   ],
   "role": "Institution",
   "start": 37.995,
   "dur": 9.15,
   "voice": null,
   "voiceStart": 38.395,
   "text": "Ananya's college, Kaveri Institute, uploads this year's admissions as a spreadsheet. Before anything is saved, twenty-six validation rules check every single row.",
   "sentences": []
  },
  {
   "id": "k04_fix",
   "section": "Chapter 1 \u00b7 The college",
   "title": "Fix, then commit",
   "points": [
    "Did-you-mean for APAAR IDs (simulated)",
    "Fix rows in place",
    "Seat impact shown first",
    "Errors never committed"
   ],
   "role": "Institution",
   "start": 47.145,
   "dur": 18.605,
   "voice": null,
   "voiceStart": 47.545,
   "text": "A mistyped APAAR ID gets a did-you-mean suggestion from the registry check, which is simulated in this prototype. Staff fix the flagged rows right on the page. Before committing, the register shows exactly what will happen to every programme's seats. A row with an error is never committed.",
   "sentences": []
  },
  {
   "id": "k05_seat",
   "section": "Chapter 1 \u00b7 The college",
   "title": "Seat check before admission",
   "points": [
    "Will one more cross the intake?",
    "Advice, not a penalty"
   ],
   "role": "Institution",
   "start": 65.75,
   "dur": 9.15,
   "voice": null,
   "voiceStart": 66.15,
   "text": "And before admitting one more student, the admission desk runs a seat check, to see if it would cross the approved intake.",
   "sentences": []
  },
  {
   "id": "k05b_dashboard",
   "section": "Chapter 1 \u00b7 The college",
   "title": "Every seat, counted",
   "points": [
    "One square per approved seat",
    "Within intake, vacant, over intake",
    "Figures from records, live"
   ],
   "role": "Institution",
   "start": 74.9,
   "dur": 14.605,
   "voice": null,
   "voiceStart": 75.3,
   "text": "On the college dashboard, every programme has a seat strip. Each square is one approved seat, filled from real student records. Seats over intake show up in red, so a college sees its position before AICTE does.",
   "sentences": []
  },
  {
   "id": "k06_national",
   "section": "Chapter 2 \u00b7 AICTE",
   "title": "The national register, live",
   "points": [
    "Computed from records, not totals",
    "Excess named per programme",
    "Narmada MBA: 68 against 60"
   ],
   "role": "AICTE",
   "start": 89.505,
   "dur": 12.423,
   "voice": null,
   "voiceStart": 89.905,
   "text": "At AICTE, the national register updates live. Every figure is computed from individual records. And the excess cannot hide: Narmada's MBA programme shows sixty-eight students against an approved intake of sixty.",
   "sentences": []
  },
  {
   "id": "k07_priority",
   "section": "Chapter 2 \u00b7 AICTE",
   "title": "Where to look first",
   "points": [
    "Ranked by transparent reasons",
    "A reason to review, not a verdict"
   ],
   "role": "AICTE",
   "start": 101.927,
   "dur": 11.332,
   "voice": null,
   "voiceStart": 102.327,
   "text": "Review priority ranks institutions by transparent reasons, such as seats over intake and conflicts with other colleges. A high rank is a reason to review, never a verdict.",
   "sentences": []
  },
  {
   "id": "k07b_flags",
   "section": "Chapter 2 \u00b7 AICTE",
   "title": "A flag is a question",
   "points": [
    "Evidence and rule on every flag",
    "Clarify, respond, resolve",
    "Full history kept"
   ],
   "role": "AICTE",
   "start": 113.259,
   "dur": 12.786,
   "voice": null,
   "voiceStart": 113.659,
   "text": "Anything a rule finds becomes a flag with its evidence. AICTE asks for clarification, the college responds, and every step stays in the history. A flag is a question, never an accusation.",
   "sentences": []
  },
  {
   "id": "k08_duplicate",
   "section": "Chapter 2 \u00b7 AICTE",
   "title": "Same student, two colleges",
   "points": [
    "Flag raised for review",
    "Other college's identity withheld",
    "Name matching explains its reasons",
    "A person decides; never auto-merged"
   ],
   "role": "AICTE",
   "start": 126.045,
   "dur": 15.695,
   "voice": null,
   "voiceStart": 126.445,
   "text": "When a student is active at two colleges, the register raises a flag. The other college's identity stays withheld. Name matching that understands Indian spellings shows exactly why two records may match, and a person decides. Nothing is merged automatically.",
   "sentences": []
  },
  {
   "id": "k09_share",
   "section": "Chapter 3 \u00b7 Ananya",
   "title": "Her record, her choice",
   "points": [
    "Signed by her college",
    "She picks the details",
    "Token and QR code"
   ],
   "role": "Student",
   "start": 141.741,
   "dur": 10.968,
   "voice": null,
   "voiceStart": 142.141,
   "text": "Now Ananya. Her college issues a signed enrolment record. She decides exactly which details to share, and the register gives her a token and a QR code.",
   "sentences": []
  },
  {
   "id": "k10_verify",
   "section": "Chapter 4 \u00b7 The employer",
   "title": "Verified in seconds",
   "points": [
    "Six checks in order",
    "Only her chosen details",
    "One changed value fails"
   ],
   "role": "Employer",
   "start": 152.709,
   "dur": 12.059,
   "voice": null,
   "voiceStart": 153.109,
   "text": "An employer pastes the token. Six checks run in order, from the signature to revocation, and only the details Ananya chose are shown. Change a single value, and verification fails.",
   "sentences": []
  },
  {
   "id": "k11_consent",
   "section": "Chapter 4 \u00b7 The employer",
   "title": "Only with her consent",
   "points": [
    "Request by APAAR ID",
    "Student allows or declines",
    "Result only after consent"
   ],
   "role": "Employer",
   "start": 164.768,
   "dur": 10.605,
   "voice": null,
   "voiceStart": 165.168,
   "text": "Employers can also send a request. Ananya sees it, sees exactly what would be shared, and allows it. Only then does the employer get an answer.",
   "sentences": []
  },
  {
   "id": "k12_minor",
   "section": "Protection",
   "title": "Students under 18",
   "points": [
    "Rule R015",
    "Held until guardian consent"
   ],
   "role": "Student",
   "start": 175.373,
   "dur": 7.332,
   "voice": null,
   "voiceStart": 175.773,
   "text": "Students under eighteen are protected. Their records cannot be shared until the college records a guardian's consent.",
   "sentences": []
  },
  {
   "id": "k13_audit",
   "section": "Accountability",
   "title": "Every action, on the record",
   "points": [
    "Hash-chained audit trail",
    "One-click chain check",
    "Public status: built, simulated, pending"
   ],
   "role": "Audit",
   "start": 182.705,
   "dur": 13.514,
   "voice": null,
   "voiceStart": 183.105,
   "text": "Every action lands in a hash-chained audit trail that an auditor verifies with one click. And a public status page states honestly what is built, what is simulated, and what still needs official access.",
   "sentences": []
  },
  {
   "id": "k14_why",
   "section": "Why it is better",
   "title": "From totals to students",
   "points": [],
   "role": "",
   "start": 196.218,
   "dur": 13.514,
   "voice": null,
   "voiceStart": 196.618,
   "text": "Seats counted from records, not declared totals. Duplicates caught early, with identities protected. Students in control of what they share. Employers verifying in seconds, not weeks. And a history no one can quietly rewrite.",
   "sentences": []
  },
  {
   "id": "k15_close",
   "section": "Close",
   "title": "APAAR Student Register",
   "points": [],
   "role": "",
   "start": 209.732,
   "dur": 9.15,
   "voice": null,
   "voiceStart": 210.132,
   "text": "APAAR Student Register. Every seat counted. Every student verifiable. Built for Smart India Hackathon, problem statement S-I-H two six two six three.",
   "sentences": []
  }
 ],
